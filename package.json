{
  "name": "deutsch-path",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Offline-capable German grammar & vocabulary trainer, A0 to CEFR B1. Static PWA, no runtime AI.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "data:fetch": "tsx scripts/fetch-sources.ts",
    "data:lexicon": "tsx scripts/build-lexicon.ts",
    "data:sentences": "tsx scripts/build-sentences.ts",
    "data:grammar": "tsx scripts/build-grammar.ts",
    "data:exercises": "tsx scripts/build-exercises.ts",
    "data:goethe": "tsx scripts/import-goethe.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:build": "npm run data:lexicon && npm run data:sentences && npm run data:grammar && npm run data:exercises && npm run data:validate"
  },
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.8",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.5.1",
    "jsdom": "^30.0.1",
    "node-html-parser": "^9.0.4",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
